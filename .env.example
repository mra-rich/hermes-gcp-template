# ===== GCP deploy config (dibaca deploy.sh) =====
# Pilih project GCP kamu (wajib diisi sebelum deploy kalau gak mau ditanya)
PROJECT_ID=

# Region/zone VM. Default = free tier (gratis):
#   us-east1 (South Carolina) | us-central1 (Iowa) | us-west1 (Oregon)
# JANGAN asia-southeast1 kalau mau tetap gratis.
REGION=us-east1
ZONE=us-east1-c

# Nama VM
VM_NAME=hermes-gcp

# Tipe mesin (e2-micro = free tier). Ganti kalau butuh lebih kuat (mulai bayar)
MACHINE_TYPE=e2-micro

# Image Hermes (pinned) — ganti untuk upgrade
IMAGE=nousresearch/hermes-agent:v2026.7.20

# ===== Dashboard (UI) — dipakai container =====
PORT=8080
ADMIN_USERNAME=admin
# Kosongkan → deploy.sh generate password acak & simpan di /data/.env VM
ADMIN_PASSWORD=

# ===== Opsional: secret penanda sesi dashboard (32+ byte acak) =====
# HERMES_DASHBOARD_BASIC_AUTH_SECRET=